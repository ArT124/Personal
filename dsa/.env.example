# Copy this file to .env for local development. On Render, set these in the dashboard.

# Port the server listens on (Render sets this automatically)
PORT=3000

# Public URL of the site (used in notifications and calendar links)
APP_URL=http://localhost:3000

# MongoDB connection string (free MongoDB Atlas M0 cluster).
# Leave empty to store data in a local JSON file (DATA_DIR) - fine for local dev,
# NOT for Render's free tier, whose disk is wiped on every restart.
MONGODB_URI=
MONGODB_DB=daily_dsa

# Folder for the JSON file store (only used when MONGODB_URI is empty)
DATA_DIR=./data

# Web Push keys. Generate with: npm run vapid
# If left empty, keys are generated once and saved in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Secret that an external cron service must send to trigger reminders.
# Generate a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=change-me

# Run the reminder check inside the server every N minutes (0 = off).
# Keep it on; the external cron also keeps the free server awake.
INTERNAL_SCHEDULER_MINUTES=5
