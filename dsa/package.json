{
  "name": "daily-dsa",
  "version": "1.1.0",
  "description": "Daily DSA: one LeetCode problem a day, in a proper learning order, with daily reminder notifications. Installable PWA for desktop and mobile.",
  "main": "server/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "vapid": "node scripts/generate-vapid.js",
    "icons": "node scripts/generate-icons.js",
    "check:curriculum": "node scripts/check-curriculum.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mongodb": "^6.10.0",
    "web-push": "^3.6.7"
  }
}
